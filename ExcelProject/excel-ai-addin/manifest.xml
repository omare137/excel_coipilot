<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="TaskPaneApp">
  <Id>01234567-89ab-cdef-0123-456789abcdef</Id>
  <Version>1.0.0.18</Version>
  <ProviderName>Excel AI Assistant</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Excel AI Assistant"/>
  <Description DefaultValue="Talk to Excel. Let AI do the work. Natural language data analysis and visualization."/>
  <IconUrl DefaultValue="https://f9f7ccb5368f.ngrok-free.app/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://f9f7ccb5368f.ngrok-free.app/support"/>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://f9f7ccb5368f.ngrok-free.app/redirect.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
           <bt:Images>
             <bt:Image id="Icon.16x16" DefaultValue="https://f9f7ccb5368f.ngrok-free.app/assets/icon-16.png"/>
             <bt:Image id="Icon.32x32" DefaultValue="https://f9f7ccb5368f.ngrok-free.app/assets/icon-32.png"/>
             <bt:Image id="Icon.80x80" DefaultValue="https://f9f7ccb5368f.ngrok-free.app/assets/icon-80.png"/>
           </bt:Images>
           <bt:Urls>
             <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://docs.microsoft.com"/>
             <bt:Url id="Commands.Url" DefaultValue="https://f9f7ccb5368f.ngrok-free.app/commands.html"/>
             <bt:Url id="Taskpane.Url" DefaultValue="https://f9f7ccb5368f.ngrok-free.app/redirect.html"/>
           </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Excel AI Assistant ready!"/>
        <bt:String id="CommandsGroup.Label" DefaultValue="AI Assistant"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Excel AI"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Talk to Excel with natural language. Create charts, clean data, and analyze with AI."/>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open Excel AI Assistant - Talk to your data with natural language."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp> 